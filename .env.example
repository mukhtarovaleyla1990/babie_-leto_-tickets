# Stripe secret key (test: sk_test_..., live: sk_live_...)
# Store ONLY in Vercel Environment Variables / local .env.local. Never commit.
STRIPE_SECRET_KEY=

# Public base URL of the site, used for Stripe success/cancel redirects.
# Local: http://localhost:3000 — Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
